{
  "name": "seraph",
  "version": "0.2.0",
  "description": "SERAPH — harness de código celestial para o terminal. Qualquer API, login com GitHub Copilot.",
  "type": "module",
  "bin": {
    "seraph": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
